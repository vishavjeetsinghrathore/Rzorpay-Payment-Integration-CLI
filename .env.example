# Test Mode only. Keep real credentials only in .env (which is ignored by Git).
# Never put keys or secrets in this example file.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
PORT=3000

# Set to false to watch the Playwright browser during `npm run test:checkout`.
HEADLESS=true
